# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium            # low | medium | high
MAX_AGENT_TURNS=8

# Where alerts come from: "fixture" (offline sample data) or "wazuh" (your lab)
SIEM_BACKEND=fixture
FIXTURE_DIR=fixtures/T1059_001

# Only needed when SIEM_BACKEND=wazuh
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_CA_CERT=                  # path to root-ca.pem printed by lab/wazuh/setup.sh
WAZUH_ALERTS_INDEX=wazuh-alerts-*
WAZUH_EVENTS_INDEX=wazuh-archives-*
